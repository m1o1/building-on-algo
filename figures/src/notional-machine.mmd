%% The notional machine: everything one app call can see, do, and change.
%% Drawn as three bands because that is the order a reader has to learn them in
%% -- what is readable, what runs, what only lands if the program approves.
flowchart TB
    subgraph reads[" What it can read "]
        direction LR
        G["The transaction group<br/>up to 16, read-only"]
        S["Its own state<br/>global · local · boxes"]
        L["Ledger facts<br/>balances · asset params · round"]
    end

    P["Approval program<br/>stack machine · 700 opcode budget per app call"]

    subgraph writes[" What it can produce "]
        direction LR
        W["Staged state writes"]
        I["Inner transactions<br/>up to 256, pooled per group"]
    end

    D{"approve?"}
    OK["Committed with the group.<br/>Writes land, inners execute."]
    NO["Nothing happens.<br/>The whole group fails."]

    G --> P
    S --> P
    L --> P
    P --> W
    P --> I
    W --> D
    I --> D
    D -->|yes| OK
    D -->|no| NO

    classDef band fill:#fafafa,stroke:#888888,color:#111111
    classDef ok fill:#f2f2f2,stroke:#333333,color:#111111
    classDef no fill:#ffffff,stroke:#333333,color:#111111,stroke-dasharray: 4 3
    class reads,writes band
    class OK ok
    class NO no
